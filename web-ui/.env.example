# Copy this file to web-ui/.env.local for local telemetry testing.
#
# Every value here is opt-in. Leave them empty and the app reports nothing anywhere.
# Do NOT point these at Cline Bot Inc.'s accounts — this is an unaffiliated fork.
# Use your own PostHog / Sentry / Featurebase projects or leave them unset.

# Product analytics. BOTH are required for analytics to initialize; there is no default host.
POSTHOG_KEY=
POSTHOG_HOST=

# Error reporting. Empty means Sentry never initializes.
SENTRY_DSN=

# In-app feedback widget. Empty means the "Send feedback" button is hidden.
FEATUREBASE_ORGANIZATION=
